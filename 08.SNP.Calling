cd /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/Finnish_Training_Samples/05.VCF/raw

mamba activate bcftools.env
bcftools stats all_samples_raw.vcf > all_samples_raw.stats

