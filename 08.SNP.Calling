###
### If .bam.bai is missing
###

# load environment containing samtools
mamba activate /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/mamba_envs/WGS_mapping  

# Copy processed samples to the final folder

cp /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/02.BAM/nodupl_RG_clip/*.bam $FINALBAMDIR
cp /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/04.BAM/nodupl_RG_clip/*.bam.bai $FINALBAMDIR

# create a list with paths
ls *.bam | sed "s|^|$PWD/|" > all.bam.list

# the indexing takes a while

while read bam; do
    if [ ! -f "${bam}.bai" ]; then
        echo "Indexing: $bam"
        samtools index "$bam"
    else
        echo "Skipping (index exists): $bam"
    fi
done < /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/02.BAM/bam_final/all.bam.list

# Sanity Check - if it does not print anything, all files are correct
samtools quickcheck *.bam

### 1. Split ref in equal data size regions to speed up the analysis #https://docs.csc.fi/apps/freebayes/
# run the script from the directory where the files are stored

cd /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/Finnish_Training_Samples/04.BAM/bam_final

vi split_ref_by_bai_datasize.py #paste code from https://github.com/freebayes/freebayes/blob/master/scripts/split_ref_by_bai_datasize.py and change 'python3' into 'python'

mamba activate freebayes.env

# this does not run for too long
python /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/Finnish_Training_Samples/split_ref_by_bai_datasize.py \
-L /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/Finnish_Training_Samples/04.BAM/bam_final/all.bam.list \
-r /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/Reference_Genome/Formica_hybrid_v1_wFhyb_Sapis.fa.fai \
-s 5000000 > /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/Reference_Genome/Formica_hybrid_v1_wFhyb_Sapis_5e6_data_regions.fa.fai

## output of the python script
#INFO 2026-01-08 16:37:12,808 [split_ref_by_bai_datasize:148 Main] :: Number of chroms: 106
#INFO 2026-01-08 16:37:12,808 [split_ref_by_bai_datasize:149 Main] :: Number of splits: 1123
#INFO 2026-01-08 16:37:12,809 [split_ref_by_bai_datasize:150 Main] :: Number of regions: 1229
#INFO 2026-01-08 16:37:12,809 [split_ref_by_bai_datasize:152 Main] :: Done: 0.49 sec elapsed

# modify regions file so that Freebayes accepts it
cd /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/Reference_Genome
awk 'BEGIN{OFS=""} {print $1,":",$2,"-",$3}' Formica_hybrid_v1_wFhyb_Sapis_5e6_data_regions.fa.fai > Formica_hybrid_v1_5e6_data_regions.tmp

#remove regions that require different SNP calling parameters if they are needed: mitchondria (mtDNA), Wolbachia (wFhyb*), and Spiroplasma (Spiroplasma*), as well as Scaffold00 
#that has unmapped reads (for cutting off SNP calling time since it will not be used anyway in the analyses I can think of)

cd /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/Reference_Genome

#grep -v -e mtDNA -e wFhyb -e Spiroplasma Formica_hybrid_v1_50kb_regions.tmp > Formica_hybrid_v1_50kb_regions.txt ; rm Formica_hybrid_v1_50kb_regions.tmp
grep -v -e mtDNA -e wFhyb -e Spiroplasma -e Scaffold00 Formica_hybrid_v1_5e6_data_regions.tmp > Formica_hybrid_v1_5e6_data_regions.txt ; rm Formica_hybrid_v1_5e6_data_regions.tmp

awk -F '[:-]' '{print $1 ":" ($2+1) "-" $3}' Formica_hybrid_v1_5e6_data_regions.txt > Formica_hybrid_v1_5e6_data_regions_1based.txt


