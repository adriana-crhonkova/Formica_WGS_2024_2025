scp /home/adriana/ReferenceSamplesLinks.txt re98maw@cool.hpc.lrz.de:/dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/02.BAM/ReferenceSamples
