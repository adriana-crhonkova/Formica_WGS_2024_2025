# Download_Ref.sh
-------------- START OF THE SCRIPT ----------------------------------------------------------------------------------------------
#!/bin/bash -l 
#SBATCH -J Download_Ref
#SBATCH -t 04:00:00
#SBATCH --get-user-env
#SBATCH --clusters=biohpc_gen
#SBATCH --partition=biohpc_gen_normal 
#SBATCH --cpus-per-task=8
#SBATCH --mem=2G
#SBATCH --mail-user ada.crhonkova@seznam.cz
#SBATCH --mail-type=END,FAIL
#SBATCH --output=download_%j.out
#SBATCH --error=download_%j.err

# set the script to stop immediately if any command fails or any part of a pipeline fails, preventing silent errors and corrupted results
set -eo pipefail

cd /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/02.BAM/ReferenceSamples

echo "Starting downloads at $(date)"

xargs -P 8 -I {} bash -c 'wget -c --progress=bar:force "{}" && echo "Finished $(basename "{}") at $(date)"' < ReferenceSamplesLinks.txt

echo "All downloads completed at $(date)"

-------------- END OF THE SCRIPT ----------------------------------------------------------------------------------------------
sacct -M biohpc_gen -j 3565920 --format=JobID,Elapsed,MaxRSS,AllocCPUS,State

ls -l *bam | wc -l
# output 104

# Adding Ref_* prefix
for f in *.bam; do
    mv "$f" "Ref_$f"
done


# creating directories
cd /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025
mkdir 03.VCF
cd /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/03.VCF
mkdir raw

------------- INTERACTIVE SESSION ---------------------------------------------------------------------------------------------
salloc --clusters=biohpc_gen --partition=biohpc_gen_inter -t 04:00:00 --mem=8G

### Copy "nodupl_RG_clip" and rename the copy bam_final
cd /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/02.BAM
cp nodupl_RG_clip bam_final

FINALBAMDIR=/dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/02.BAM/bam_final


### Copy reference samples to the final folder
cp *bam $FINALBAMDIR

### If .bam.bai is missing

# load environment containing samtools
mamba activate /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/mamba_envs/WGS_mapping  

# create a list with paths
ls *.bam | sed "s|^|$PWD/|" > all.bam.list

# the indexing takes a while

while read bam; do
    if [ ! -f "${bam}.bai" ]; then
        echo "Indexing: $bam"
        samtools index "$bam"
    else
        echo "Skipping (index exists): $bam"
    fi
done < /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/02.BAM/bam_final/all.bam.list

# Sanity Check - if it does not print anything, all files are correct (takes a few seconds)
samtools quickcheck *.bam

### 1. Split ref in equal data size regions to speed up the analysis #https://docs.csc.fi/apps/freebayes/
# run the script from the directory where the files are stored

cd /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/02.BAM/bam_final

vi split_ref_by_bai_datasize.py #paste code from https://github.com/freebayes/freebayes/blob/master/scripts/split_ref_by_bai_datasize.py and change 'python3' into 'python'

mamba activate freebayes.env

# this does not run for too long
python /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/split_ref_by_bai_datasize.py \
-L /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/02.BAM/bam_final/all.bam.list \
-r /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/Reference_Genome/Formica_hybrid_v1_wFhyb_Sapis.fa.fai \
-s 5000000 > /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/Reference_Genome/Formica_hybrid_v1_wFhyb_Sapis_5e6_data_regions.fa.fai

## output of the python script
#INFO 2026-03-04 12:49:29,643 [split_ref_by_bai_datasize:148 Main] :: Number of chroms: 106
#INFO 2026-03-04 12:49:29,643 [split_ref_by_bai_datasize:149 Main] :: Number of splits: 10972
#INFO 2026-03-04 12:49:29,643 [split_ref_by_bai_datasize:150 Main] :: Number of regions: 11078
#INFO 2026-03-04 12:49:29,643 [split_ref_by_bai_datasize:152 Main] :: Done: 7.80 sec elapsed

# modify regions file so that Freebayes accepts it
cd /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/Reference_Genome
awk 'BEGIN{OFS=""} {print $1,":",$2,"-",$3}' Formica_hybrid_v1_wFhyb_Sapis_5e6_data_regions.fa.fai > Formica_hybrid_v1_5e6_data_regions.tmp

#remove regions that require different SNP calling parameters if they are needed: mitchondria (mtDNA), Wolbachia (wFhyb*), and Spiroplasma (Spiroplasma*), as well as Scaffold00 
#that has unmapped reads (for cutting off SNP calling time since it will not be used anyway in the analyses I can think of)

cd /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/Reference_Genome

#grep -v -e mtDNA -e wFhyb -e Spiroplasma Formica_hybrid_v1_50kb_regions.tmp > Formica_hybrid_v1_50kb_regions.txt ; rm Formica_hybrid_v1_50kb_regions.tmp
grep -v -e mtDNA -e wFhyb -e Spiroplasma -e Scaffold00 Formica_hybrid_v1_5e6_data_regions.tmp > Formica_hybrid_v1_5e6_data_regions.txt ; rm Formica_hybrid_v1_5e6_data_regions.tmp

awk -F '[:-]' '{print $1 ":" ($2+1) "-" $3}' Formica_hybrid_v1_5e6_data_regions.txt > Formica_hybrid_v1_5e6_data_regions_1based.txt


------------- EXIT INTERACTIVE SESSION ---------------------------------------------------------------------------------------------



### !!! NOT EDITED YET !!! ###





###
### Full SNP calling
###
# --skip-coverage = total DP combined across all samples; assuming max 400x per sample per region, 400X per sample * 103 samples = 41200X
# use screen for the SNP calling https://linuxize.com/post/how-to-use-linux-screen/?utm_content=cmp-true
# I am not using screen but slurm job. I feel it is more user friendly for me and have more experience with it. 


# 06_SNPcalling.sh
---------------------- START OF SCRIPT ------------------------------------------------------------------------------------------------------

#!/bin/bash 
#SBATCH -J SNPcalling
#SBATCH -o /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/Finnish_Training_Samples/05.VCF/raw/SNPcalling.out
#SBATCH -e /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/Finnish_Training_Samples/05.VCF/raw/SNPcalling.err
#SBATCH -t 48:00:00
#SBATCH --get-user-env
#SBATCH --clusters=biohpc_gen
#SBATCH --partition=biohpc_gen_normal
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --mail-user ada.crhonkova@seznam.cz
#SBATCH --mail-type=END,FAIL

# set the script to stop immediately if any command fails or any part of a pipeline fails, preventing silent errors and corrupted results
set -eo pipefail

# Load environment
eval "$(mamba shell hook --shell bash)"
mamba activate /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/mamba_envs/freebayes_updated.env

# Define directories
cd /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/Finnish_Training_Samples/05.VCF
REF=/dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/Reference_Genome
RES=/dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/Finnish_Training_Samples/05.VCF
BAM=/dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/Finnish_Training_Samples/04.BAM/bam_final


freebayes-parallel \
  $REF/Formica_hybrid_v1_5e6_data_regions_1based.txt \
  $SLURM_CPUS_PER_TASK \
  -f $REF/Formica_hybrid_v1_wFhyb_Sapis.fa \
  -L $BAM/all.bam.list \
  -k \
  --genotype-qualities \
  --skip-coverage 4000 \
  --limit-coverage 100 \
  --use-best-n-alleles 3 \
  > "$RES/raw/all_samples_raw.vcf"

# on Finnish cluster freebayes run automatically in parallel

# max mean depth as per 'vcftools --depth' was 46x for sample 108-Flug. Later on all sites that have 2x per ind mean depth are anyway set as '.', which is why limiting to 100x with '--limit-coverage' is safe.
# -E N=-1 disable complex variants #NOT USED CURRENTLY -  does it mess up w snpgap and vcfallelicprimitives later on?
# --use-best-n-alleles 3 = reduce computational time to exclude multiple alternative alleles if present. Setting to 3 is safe since all but biallelic sites will be filtered out later on.

-------------- END OF SCRIPT ----------------------------------------------------------------------------------------------------------------------------

sacct -M biohpc_gen -j 3483676 --format=JobID,Elapsed,MaxRSS,AllocCPUS,State
       JobID    Elapsed     MaxRSS  AllocCPUS      State
------------ ---------- ---------- ---------- ----------
3483676        02:45:16                    16  COMPLETED
