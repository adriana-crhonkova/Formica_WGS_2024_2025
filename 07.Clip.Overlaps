### Create the input file list
cd /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/02.BAM/nodupl_RG

# sort numeric, according to position 1,1
ls *bam | sort -nk1,1 > input.list  

### Create the output folder
cd /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/02.BAM
mkdir nodupl_RG_clip

# 07_clipOverlap.sh
------------- START OF THE SCRIPT ----------------------------------------------------------------------------------------------------------------------

#!/bin/bash 
#SBATCH -J clipOverlap
#SBATCH -o 02.BAM/logs/clipOverlap_%j.out
#SBATCH -e 02.BAM/logs/clipOverlap_%j.err
#SBATCH -t 01:00:00
#SBATCH --get-user-env
#SBATCH --clusters=biohpc_gen
#SBATCH --partition=biohpc_gen_normal
#SBATCH --array=1-89%8
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=1GB
#SBATCH --mail-user ada.crhonkova@seznam.cz
#SBATCH --mail-type=END,FAIL

# set the script to stop immediately if any command fails or any part of a pipeline fails, preventing silent errors and corrupted results
set -eo pipefail

# Load environment
# include bamUtil v1.0.15, samtools v1.9
eval "$(mamba shell hook --shell bash)"
mamba activate /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/mamba_envs/bamUtil


# Define directories
cd /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/02.BAM/nodupl_RG
INPUTDIR=/dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/02.BAM/nodupl_RG
FINALDIR=/dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/02.BAM/nodupl_RG_clip

# Get file & sample ID
file=$(sed -n "$SLURM_ARRAY_TASK_ID"p input.list)
sample=${file%_nodupl_wRG*}

echo "### Processing $file"


###
### Clip overlaps
###

# Reads are sorted by coordinates (see "samtools sort" command after mapping)
bam clipOverlap --in $INPUTDIR/${sample}"_nodupl_wRG.bam" --out $FINALDIR/${sample}"_nodupl_wRG_clip.bam" --stats --params

echo "### Indexing"
###
### Index
###

samtools index $FINALDIR/$sample"_nodupl_wRG_clip.bam"

echo "### DONE: $file"

------------- END OF THE SCRIPT ----------------------------------------------------------------------------------------------------------------------
sacct -M biohpc_gen -j 3558900 --format=JobID,Elapsed,MaxRSS,AllocCPUS,State


------------- INTERACTIVE JOB --------------------------------------------------------------------------------------------------------

# Request an interactive job
salloc --clusters=biohpc_gen --partition=biohpc_gen_inter -t 01:00:00 --mem=2G

mamba activate /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/mamba_envs/WGS_mapping  

