cd /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/02.BAM/nodupl_RG
picard ValidateSamFile I=A_74a_EKDN240013500-1A_223FHVLT4_L7_nodupl_wRG.bam R=/dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/Reference_Genome/Formica_hybrid_v1_wFhyb_Sapis.fa MODE=SUMMARY

