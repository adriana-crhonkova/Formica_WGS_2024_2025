------------ ---------- ---------- ---------- ----------
3578262        17:20:55                     8  COMPLETED
3578262.bat+   17:20:55   3569444K          8  COMPLETED


------------- INTERACTIVE SESSION 1 ---------------------------------------------------------------------------------------------------------------------------------------------
salloc --clusters=biohpc_gen --partition=biohpc_gen_inter -t 04:00:00 --mem=8G --cpus-per-task=4

mamba activate /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/mamba_envs/bcftools.env

# Sanity check (optional) - test whether the file can be fully read without errors
bcftools view all_samples.normalized.SnpGap_2.NonSNP.Balance.PASS.decomposed.SNPQ30.biall.vcf.gz > /dev/null

##
## 2. Prep for max DP filtering -------------------------------------------------------------------
##

### a. Correct field IDs (MNV issue)

# Extract header from VCF
bcftools view -h all_samples.normalized.SnpGap_2.NonSNP.Balance.PASS.decomposed.SNPQ30.biall.vcf.gz > header.vcf
       ## Reference samples have different headers then file names
       # cd /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/02.BAM/ReferenceSamples
       # mamba activate bamUtil
       # samtools view -H Ref_102_nodupl_wRG_clip.bam | grep SM
              # @RG     ID:102-Frufa    LB:1    PL:illumina     SM:102-Frufa    PU:1


# Fix fields - this prevents parsing errors after variant decomposition
perl -npe 's/<ID=AO,Number=A/<ID=AO,Number=\./' header.vcf | perl -npe 's/<ID=AD,Number=R/<ID=AD,Number=\./' | perl -npe 's/<ID=QA,Number=A/<ID=QA,Number=\./' | perl -npe 's/<ID=GL,Number=G/<ID=GL,Number=\./' > header_AO_AD_QA_GL.vcf

# Replace corrected header
bcftools reheader -h header_AO_AD_QA_GL.vcf -o all_samples.normalized.SnpGap_2.NonSNP.Balance.PASS.decomposed.SNPQ30.biall.fixedHeader.vcf.gz all_samples.normalized.SnpGap_2.NonSNP.Balance.PASS.decomposed.SNPQ30.biall.vcf.gz

# Check fraction missing data
vcftools --gzvcf all_samples.normalized.SnpGap_2.NonSNP.Balance.PASS.decomposed.SNPQ30.biall.fixedHeader.vcf.gz --missing-indv --out all_samples.normalized.SnpGap_2.NonSNP.Balance.PASS.decomposed.SNPQ30.biall.fixedHeader.MISSING_DATA
       # After filtering, kept 193 out of 193 Individuals
       # Outputting Individual Missingness
       # After filtering, kept 6131156 out of a possible 6131156 Sites
       # Run Time = 328.00 seconds

# Quick Quality Check
cut -f5 all_samples.normalized.SnpGap_2.NonSNP.Balance.PASS.decomposed.SNPQ30.biall.fixedHeader.MISSING_DATA.imiss | grep -v 'F_' | awk '{sum+=$1;} END{print sum/NR;}'
       # 0.0333245

### b. Compute mean DP per individual
vcftools --depth --gzvcf all_samples.normalized.SnpGap_2.NonSNP.Balance.PASS.decomposed.SNPQ30.biall.fixedHeader.vcf.gz --out all_samples.normalized.SnpGap_2.NonSNP.Balance.PASS.decomposed.SNPQ30.biall.fixedHeader


Rscript minMaxDP.R      
       # did not work
touch minMaxDP_updated.R 
vi minMaxDP_updated.R 
----------------------------- R Script ----------------------------------------------------------------------
# Load the table
dat <- read.table(
  "all_samples.normalized.SnpGap_2.NonSNP.Balance.PASS.decomposed.SNPQ30.biall.fixedHeader.idepth",
  header = TRUE,
  stringsAsFactors = FALSE
)

# Compute min/max depth per sample
dat$MIN_DEPTH <- round((dat$MEAN_DEPTH - 0.5)/2)  # min = half mean depth
dat$MAX_DEPTH <- round(dat$MEAN_DEPTH * 2)        # max = twice mean depth

# Save result
write.table(
  dat,
