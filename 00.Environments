# Old Environment for trimming and FastQC
mamba create -p /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/mamba_envs/WGS_test_env 
mamba activate WGS_test_env
mamba install -c bioconda trimmomatic=0.39
mamba install -c bioconda fastqc

# New Environment for trimming 
mamba create -p /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/mamba_envs/FastP
mamba activate FastP
mamba install -c bioconda fastp
fastp --version    # fastp 0.22.0
mamba install -c bioconda multiqc

# Environment for mapping and read groups
mamba create -p /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/mamba_envs/WGS_mapping
mamba activate WGS_mapping
mamba install -c bioconda bwa=0.7.17
mamba install -c bioconda samtools    # old versions were not compatible, current version is samtools 1.9
mamba install -c bioconda picard=2.27.5  
mamba install r-base=4.2

# Mosdepth environment
mamba create -p /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/mamba_envs/mosdepth
mamba activate mosdepth
mamba install -c bioconda mosdepth
# mosdepth v0.3.3

# bamUtil environment
mamba create -p /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/mamba_envs/bamUtil
mamba activate bamUtil
mamba install -c conda-forge -c bioconda bamutil=1.0.15
mamba install -c bioconda samtools  # samtools 1.9

# freebayes environment
mamba create -p /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/mamba_envs/freebayes.env
mamba activate freebayes.env
mamba install -c conda-forge -c bioconda   freebayes=1.3.6
mamba install -c bioconda samtools

# freebayes environment update 
## the previous was not working for SNP calling, ChatGPT recommended to update htslib
mamba create -p /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/mamba_envs/freebayes_updated.env
mamba activate freebayes_updated.env
mamba install -c conda-forge -c bioconda freebayes=1.3.6 htslib=1.16 python=3.10 numpy scipy samtools 
# samtools 1.16.1 Using htslib 1.16

# bcftools environment
mamba create -p /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/mamba_envs/bcftools.env
mamba activate bcftools.env
mamba install -c conda-forge -c bioconda bcftools vcftools=0.1.17 r-base=4.2
# bcftools=1.10 vcftools=0.1.17 not compatible 
# bcftools 1.23 installed
mamba install -c bioconda vcflib

# PCA environment
mamba create -p /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/mamba_envs/pca.env
mamba activate pca.env
mamba install -c conda-forge -c bioconda r-base=4.2 bioconductor-snprelate
