# prepare output directories
cd /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/02.BAM/stats
mkdir coverage


###
### Compute sequencing depth per sample (after duplicate removal) 
###

# 06.mosdepth.sh
------------- START OF THE SCRIPT ----------------------------------------------------------------------------------------------------------------------

#!/bin/bash
#SBATCH -J mosdepth
#SBATCH -o 02.BAM/logs/mosdepth_%j.out
#SBATCH -e 02.BAM/logs/mosdepth_%j.err
#SBATCH -t 01:00:00
#SBATCH --get-user-env
#SBATCH --clusters=biohpc_gen
#SBATCH --partition=biohpc_gen_normal
#SBATCH --array=1-89%8
#SBATCH --cpus-per-task=1
#SBATCH --mem=2G
#SBATCH --mail-user ada.crhonkova@seznam.cz
#SBATCH --mail-type=END,FAIL

# set the script to stop immediately if any command fails or any part of a pipeline fails, preventing silent errors and corrupted results
set -eo pipefail

# Load environment mosdepth
eval "$(mamba shell hook --shell bash)"
mamba activate mosdepth

FINALDIR=/dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/02.BAM/nodupl_RG

# from here we just take the names
cd /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/02.BAM/nodupl

# Get file
file=$(sed -n "$SLURM_ARRAY_TASK_ID"p nodupl_name.list)

# Get sample ID
sample=${file%_nodupl*}

mosdepth -t 1 -b 10000 -n -x ../stats/coverage/$sample $FINALDIR/$sample"_nodupl_wRG.bam"
mosdepth -t 1 -b 10000 -n ../stats/coverage/${sample}_overlap_correction $FINALDIR/$sample"_nodupl_wRG.bam"

------------- END OF THE SCRIPT ----------------------------------------------------------------------------------------------------------------------
sacct -M biohpc_gen -j 3558696 --format=JobID,Elapsed,MaxRSS,AllocCPUS,State,Nodelist

# MultiQC
cd /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/02.BAM/stats
mamba activate QualityControl
multiqc coverage -o coverage/multiqc


### Get coverage for overlap corrected data  --------------------

cd /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/02.BAM/stats/coverage
rm -rf *global*

for i in *overlap_correction.mosdepth.summary.txt; do echo $i; grep 'Scaffold' "$i" | awk '{sum+=$4} END{print sum/NR}'; done > all.overlap_correction.mosdepth.summary.tmp

grep -v 'txt' all.overlap_correction.mosdepth.summary.tmp > tmp1
grep 'txt' all.overlap_correction.mosdepth.summary.tmp | perl -npe 's/_overlap_correction.mosdepth.summary.txt//' > tmp2
paste tmp2 tmp1 > all.overlap_correction.mosdepth.summary.txt ; rm *tmp*

#this makes the right computation (excludes scaffs 00 & 03), although it doesn't take into account the different chr lengths which is perhaps now ok

for i in *_overlap_correction.mosdepth.summary.txt; do
    # Skip the output file if it already exists
    [[ "$i" == "all.overlap_correction_no0003.mosdepth.summary.tmp" ]] && continue
    sample=${i%_overlap_correction.mosdepth.summary.txt}
    avg=$(awk '$1 ~ /Scaffold/ && $1 != "Scaffold00" && $1 != "Scaffold03" && $1 != "region" {sum+=$4; n++} END {if(n>0) print sum/n; else print "NA"}' "$i")
    echo -e "$sample\t$avg"
done > all.overlap_correction_no0003.mosdepth.summary.txt

scp re98maw@cool.hpc.lrz.de:/dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/02.BAM/stats/coverage/all.overlap_correction_no0003.mosdepth.summary.txt .

### Get coverage for *NON* overlap corrected data  --------------------

for i in $(ls *.mosdepth.summary.txt | grep -v overlap_correction); do
  echo $i
  grep 'Scaffold' "$i" | awk '{sum+=$4} END{print sum/NR}'
done > all.no_overlap_correction.mosdepth.summary.tmp

grep -v 'txt' all.no_overlap_correction.mosdepth.summary.tmp > tmp1
grep 'txt' all.no_overlap_correction.mosdepth.summary.tmp | perl -npe 's/.mosdepth.summary.txt//' > tmp2
paste tmp2 tmp1 > all.no_overlap_correction.mosdepth.summary.txt
rm *tmp*

scp re98maw@cool.hpc.lrz.de:/dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/02.BAM/stats/coverage/all.no_overlap_correction.mosdepth.summary.txt .

