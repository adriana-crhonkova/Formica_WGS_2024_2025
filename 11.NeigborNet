#This is to construct a phylogenetic network based on NeighbourNet approach (loosely based on the neighbor joining algorithm). 
#The input is a distance matrix and the algorithm works by agglomerating clusters, and it is run using SplitsTree with default parameters.
#The script follows the pipeline in SH Martin et al. 2019 (https://doi.org/10.1371/journal.pbio.2006288).
#https://github.com/simonhmartin/genomics_general/blob/master/genomics.py 
#https://github.com/simonhmartin/genomics_general/blob/master/distMat.py
#https://github.com/simonhmartin/genomics_general/blob/master/VCF_processing/parseVCF.py
# genomics.py is called in distMat.py!

---------- INTERACTIVE SESSIONS --------------------------------------------------------------------------------
salloc --clusters=biohpc_gen --partition=biohpc_gen_inter -t 01:00:00 --mem=8G --ntasks=1

#USE 20KB THINNED (MAC2 FILTERED) VCF (to replicate Satokangas et al 2023), inspect amount of missing data.
mamba activate bcftools.env

VCFPATH=/dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/03.VCF/filt
VCFIN=DP8.AN10.noScaff0003.mac2.thin20kb.vcf.gz

vcftools --gzvcf $VCFPATH/$VCFIN --missing-indv --out $VCFPATH/${VCFIN}.missing
sort -k 5 $VCFPATH/${VCFIN}.missing.imiss | column -t # RN421 51% missingness


# correct for python scripts to be usable
bcftools +fixploidy DP8.AN10.noScaff0003.mac2.thin20kb.vcf.gz \
  -Oz -o DP8.AN10.noScaff0003.mac2.thin20kb.fixedGT.vcf.gz

#sanity check - if it prints nothing, it is good
bcftools query -f '%CHROM\t%POS[\t%GT]\n' DP8.AN10.noScaff0003.mac2.thin20kb.fixedGT.vcf.gz \
  | awk '{for(i=3;i<=NF;i++) if($i==".") print $0}'

# Indexing 
bcftools index DP8.AN10.noScaff0003.mac2.thin20kb.fixedGT.vcf.gz

--------------- END OF INTERACTIVE SESSION --------------------------------------------------------------------------------------------------------
sacct -M biohpc_gen -j 3588004 --format=JobID,Elapsed,MaxRSS,AllocCPUS,State



# edit version issue of Numpy from NaN to nan
sed -i.bak 's/np\.NaN/np.nan/g' /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/genomics.py

cd /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/03.VCF
mkdir NeigbourNet

# 16_geno_20kbthin.sh
------------- START OF THE SCRIPT 1 --------------------------------------------------------------------------------------------------------------------

#!/bin/bash -l
#SBATCH -J geno_20kbthin
#SBATCH -o /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/03.VCF/NeigbourNet/geno_20kbthin_%j.out
#SBATCH -e /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/03.VCF/NeigbourNet/geno_20kbthin_%j.err
#SBATCH -t 04:00:00
#SBATCH --get-user-env
#SBATCH --clusters=biohpc_gen
#SBATCH --partition=biohpc_gen_normal
#SBATCH --mem=50G
#SBATCH --mail-user=ada.crhonkova@seznam.cz
#SBATCH --mail-type=END,FAIL

# set the script to stop immediately if any command fails or any part of a pipeline fails, preventing silent errors and corrupted results
set -eo pipefail

# Load environment
# Contains freebayes=1.3.6 htslib=1.16 python=3.10 numpy scipy samtools=1.16.1
eval "$(mamba shell hook --shell bash)"
mamba activate /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/mamba_envs/freebayes_updated.env


cd /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/03.VCF/NeigbourNet

VCFPATH=/dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/03.VCF/filt
FILTVCF=DP8.AN10.noScaff0003.mac2.thin20kb.fixedGT.vcf.gz
GENO=DP8.AN10.noScaff0003.mac2.thin20kb.fixedGT.vcf.gz
DISTMAT=DP8.AN10.noScaff0003.mac2.thin20kb.fixedGT.dist

echo "running parseVCF.py"
python /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/parseVCF.py -i $VCFPATH/$FILTVCF | bgzip > $GENO &&

echo "running distMat.py"
python /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/distMat.py -g $GENO -f phased --windType cat -o $DISTMAT

------------- END OF THE SCRIPT --------------------------------------------------------------------------------------------------------------------

sacct -M biohpc_gen -j 3588057 --format=JobID,Elapsed,MaxRSS,AllocCPUS,State


scp re98maw@cool.hpc.lrz.de:/dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/03.VCF/NeigbourNet/DP8.AN10.noScaff0003.mac2.thin20kb.fixedGT.dist .

# (If needed: Modify the sample names so that Finnish ones have only the number and from Pierre's samples
#  only "Lai" has the 1/2w extension: done manually; find&replace in Atom)
# -> done; see file DP8AN10.NoScaff0003.mac2.noInds417.418.105.110.353.354_numonly.dist

# Open SplitsTree, and draw the tree with default settings.
# Works in a few seconds; just import the file and the tree will appear.

# In splitstree:
# node shape: circle, size 5 (Edit -> select labeled nodes; View -> Format nodes and edges.

### Optional continuation

cd /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/03.VCF/filt
# ind.list contains all samples (created in previous steps); 193 samples
# remove_samples.txt contains samples which were removed for too high missingness; 7 samples

cp ind.list keep_only_Aq_branch.tmp
sort keep_only_Aq_branch.tmp > keep_only_Aq_branch_sorted.tmp
sort remove_samples.txt > remove_samples_sorted.txt
grep -v -F -f remove_samples_sorted.txt keep_only_Aq_branch_sorted.tmp > keep_only_Aq_branch.txt # 186 lines
rm keep_only_Aq_branch_sorted.tmp

# RN415-RN426 (undetermined references) manually; left with 176 samples
touch remove_polyctena_branch.tmp
vi remove_polyctena_branch.tmp
# paste the IDs 
sort remove_polyctena_branch.tmp > remove_polyctena_branch_sorted.txt
rm remove_polyctena_branch.tmp

grep -v -F -f remove_polyctena_branch_sorted.txt keep_only_Aq_branch.txt > keep_only_Aq_branch_final.txt # 131 lines


---------------INTERACTIVE SESSION -------------------------------------------------------------------------------------------------------------------
salloc --clusters=biohpc_gen --partition=biohpc_gen_inter -t 01:00:00 --mem=8G --ntasks=1

##### FILTERING INDIVIDUALS AND RE-RUNNING THE SCRIPT
## example
# vcftools --gzvcf input.vcf.gz \
# --keep keep_samples.txt \
#  --recode --recode-INFO-all \
#  --stdout | bgzip > filtered_samples.vcf.gz

mamba activate bcftools.env

VCFPATH=/dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/03.VCF/filt
VCFIN=DP8.AN10.noScaff0003.mac2.thin20kb.vcf.gz

## Filtering RN415-RN426 (undetermined references), F. rufa, F. polyctena, F. pratensis, F. exsecta 
# The aim is to see clustering of F. aquilonia branch samples

vcftools --gzvcf $VCFPATH/$VCFIN \
  --keep keep_only_Aq_branch_final.txt \
  --recode --recode-INFO-all \
  --stdout | bgzip > $VCFPATH/DP8.AN10.noScaff0003.mac2.thin20kb.AqBranch.vcf.gz

VCFFILT=DP8.AN10.noScaff0003.mac2.thin20kb.AqBranch.vcf.gz

# Check for missingness
vcftools --gzvcf $VCFPATH/$VCFFILT --missing-indv --out $VCFPATH/${VCFFILT}.missing
sort -k 5 $VCFPATH/${VCFFILT}.missing.imiss | column -t # none over 50%


# correct for python scripts to be usable
bcftools +fixploidy DP8.AN10.noScaff0003.mac2.thin20kb.AqBranch.vcf.gz \
  -Oz -o DP8.AN10.noScaff0003.mac2.thin20kb.AqBranch.fixedGT.vcf.gz

#sanity check - if it prints nothing, it is good
bcftools query -f '%CHROM\t%POS[\t%GT]\n' DP8.AN10.noScaff0003.mac2.thin20kb.AqBranch.fixedGT.vcf.gz \
  | awk '{for(i=3;i<=NF;i++) if($i==".") print $0}'

# Indexing 
bcftools index DP8.AN10.noScaff0003.mac2.thin20kb.AqBranch.fixedGT.vcf.gz
--------------- END OF INTERACTIVE SESSION --------------------------------------------------------------------------------------------------------
sacct -M biohpc_gen -j 3592455 --format=JobID,Elapsed,MaxRSS,AllocCPUS,State


