### ADMIXTURE analysis ###
salloc --clusters=biohpc_gen --partition=biohpc_gen_inter -t 04:00:00 --mem=2G --cpus-per-task=4

module load biokit # what tools do i need? Plink

#### What is the filter based on?
## edit input and output files
VCF=/dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/03.VCF/filt/DP8AN10.NoScaff0003.mac2.noInds417.418.105.110.353.354.vcf.gz
OUTVCF=/dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/03.VCF/filt/DP8AN10.NoScaff0003.mac2.noInds417.418.105.110.353.354_thin20kb.vcf.gz

#Thin the VCF with 20kb distances to reduce linkage

vcftools --gzvcf $VCF --thin 20000 --recode --stdout | bgzip > $OUTVCF
bcftools index -t $OUTVCF
bcftools index -n $OUTVCF #9279 SNPs

# Convert the VCF ("OUTVCF") into PLINK format for ADMIXTURE analysis and keep only the desired individuals (in "LIST")

LIST=balanced_sample_list.list
OUTPATH=/scratch/project_2001443/barriers_introgr_formica/gen_str/admixture/balanced
OUTFILE=DP8AN10.NoScaff0003.mac2.noInds417.418.105.110.353.354_thin20kb

$PROJAPPL/PLINK/plink --threads 1 --vcf $OUTVCF --make-bed \
--double-id --allow-extra-chr --set-missing-var-ids @:# \
--keep $OUTPATH/$LIST \
--out $OUTPATH/$OUTFILE

# ADMIXTURE doesn't accept non-human chromosome names. Replace the first column by 0.

cd $OUTPATH
awk '{$1=0;print $0}' $OUTFILE.bim > $OUTFILE.bim.tmp
mv $OUTFILE.bim.tmp $OUTFILE.bim


sbatch admixture.sh

####For record the admixture.sh:

------------- START OF THE SCRIPT -----------------------------------------------------------------------------------------------------------

#!/bin/bash -l
#SBATCH -J admixture
#SBATCH -o /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/03.VCF/admixture/balanced/logs/admixture.out
#SBATCH -e /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/03.VCF/admixture/balanced/logs/admixture.err
#SBATCH -t 00:30:00
#SBATCH --get-user-env
#SBATCH --clusters=biohpc_gen
#SBATCH --partition=biohpc_gen_normal
#SBATCH --ntasks 1
#SBATCH --mem=8G
#SBATCH --mail-user=ada.crhonkova@seznam.cz
#SBATCH --mail-type=END,FAIL

# set the script to stop immediately if any command fails or any part of a pipeline fails, preventing silent errors and corrupted results
set -eo pipefail

# Load environment
eval "$(mamba shell hook --shell bash)"
mamba activate #### plink

cd /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/03.VCF/admixture/balanced

OUTPATH=/dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/03.VCF/admixture/balanced
FILE=DP8AN10.NoScaff0003.mac2.noInds417.418.105.110.353.354_thin20kb

for i in {2..7}
do
admixture --cv $OUTPATH/$FILE.bed $i > log${i}.out

done

grep "CV" *out | awk '{print $3,$4}' | cut -c 4,7-20 > $FILE.cv.error

------------ END OF THE SCRIPT -----------------------------------------------------------------------------------------------------------


