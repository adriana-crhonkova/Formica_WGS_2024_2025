#SBATCH --get-user-env
#SBATCH --clusters=biohpc_gen
#SBATCH --partition=biohpc_gen_normal 
#SBATCH --cpus-per-task=8
#SBATCH --mem=8G
#SBATCH --mail-user ada.crhonkova@seznam.cz
#SBATCH --mail-type=END,FAIL

# set the script to stop immediately if any command fails or any part of a pipeline fails, preventing silent errors and corrupted results
set -eo pipefail

## Load environment
# include picard, samtools, bwa and r-base
eval "$(mamba shell hook --shell bash)"
mamba activate /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/mamba_envs/WGS_mapping  

cd /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/temp

# Setting the paths
TMPBAMPATH=/dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/temp
MERGEDBAMPATH=/dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/temp/merged_BAM

### Merging BAMs

# list of unique sample prefixes
samples=$(cut -d'_' -f1-2 name.list.merge | sort -u)

for sample in $samples; do
    echo "Merging $sample"
    echo "Files: " $TMPBAMPATH/${sample}_*.bam
  samtools merge -@8 \
    $MERGEDBAMPATH/${sample}.merged.bam \
    $TMPBAMPATH/${sample}_*.bam
done
