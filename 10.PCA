### PCA DATASET 2
# Dropping samples of F. excecta and F. pratensis
--------------- R Script -------------------------------------------------------------------------------------

# run_pca_snprelate_drop_safe.R
library(SNPRelate)

# ---------------------------
# Define input and output paths
# ---------------------------
vcf.fn <- "/dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/03.VCF/filt/DP8.AN10.noScaff0003.mac2.thin20kb.vcf.gz"

# NEW GDS file for PCA with dropped samples
gds.fn <- "/dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/03.VCF/pca/DP8_drop.gds"

# NEW output prefix for CSVs
out.prefix <- "/dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/03.VCF/pca/DP8_PCA_drop"

# ---------------------------
# Define samples to drop
# ---------------------------
samples_to_drop <- c(
  "120-Fprat", "123-Fprat", "6-Fprat", "122-Fprat", "117-Fprat", 
  "3-Fprat", "2-Fprat", 
  "LMUF_00014a.merged", "LMUF_00349c.merged", "LMUF_00427b.merged",
  "LMUF_00011a.merged", "LMUF_00030a.merged", "LMUF_00034a.merged"
)

# ---------------------------
# Convert VCF to GDS
# ---------------------------
cat("=== Converting VCF to GDS ===\n")
snpgdsVCF2GDS(vcf.fn, gds.fn, method="copy.num.of.ref")

# ---------------------------
# Open GDS file
# ---------------------------
cat("=== Opening GDS file ===\n")
genofile <- snpgdsOpen(gds.fn)

# ---------------------------
# Check SNP summary
# ---------------------------
cat("=== Checking SNP summary ===\n")
print(snpgdsSummary(genofile))

# ---------------------------
# Determine samples to keep
# ---------------------------
all_samples <- read.gdsn(index.gdsn(genofile, "sample.id"))
samples_keep <- setdiff(all_samples, samples_to_drop)
cat("Samples kept:", length(samples_keep), "\n")

# ---------------------------
# Run PCA
# ---------------------------
cat("=== Running PCA ===\n")
pca <- snpgdsPCA(
  genofile, 
  num.thread = 1, 
  autosome.only = FALSE, 
  sample.id = samples_keep
)

pc.percent <- pca$varprop * 100

# ---------------------------
# Save PCA results
# ---------------------------
pca.df <- data.frame(
  sample = pca$sample.id,
  PC1 = pca$eigenvect[,1],
  PC2 = pca$eigenvect[,2],
  PC3 = pca$eigenvect[,3],
  PC4 = pca$eigenvect[,4],
  stringsAsFactors = FALSE
)

write.csv(pca.df, paste0(out.prefix, "_scores.csv"), row.names = FALSE)
write.csv(round(pc.percent, 2), paste0(out.prefix, "_variance.csv"), row.names = FALSE)

# ---------------------------
# Close GDS
# ---------------------------
cat("=== PCA completed successfully ===\n")
snpgdsClose(genofile)

-------------------- END OF R SCRIPT  -------------------------------------------------------------------------------------
sacct -M biohpc_gen -j 3587025 --format=JobID,Elapsed,MaxRSS,AllocCPUS,State,NodeList

scp -r re98maw@cool.hpc.lrz.de:/dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/03.VCF/pca/*drop* .

