---------------INTERACTIVE SESSION ------------------------------------------------------
salloc --clusters=biohpc_gen --partition=biohpc_gen_inter -t 01:00:00 --mem=8G --ntasks=1

mamba activate bcftools.env

cd /dss/dsslegfs01/pn73qe/pn73qe-dss-0002/Formica_WGS/WGS_2024_2025/03.VCF/filt
# keep_only_Aq_branch_final.txt # 131 lines

touch admixed.samples.txt # add names of admixed 1,2 references # 17 samples
cp keep_only_Aq_branch_final.txt keep_only_Aq_branch_final_noAdmixed.tmp

sort keep_only_Aq_branch_final_noAdmixed.tmp > keep_only_Aq_branch_final_noAdmixed_sorted.tmp
sort admixed.samples.txt > admixed.samples.sorted.txt
grep -v -x -F -f admixed.samples.sorted.txt keep_only_Aq_branch_final_noAdmixed_sorted.tmp > keep_only_Aq_branch_final_noAdmixed_sorted.txt 
# output 116 but should be 114 - two admixed samples filtered for missingness in vcf filtering - the number of samples fits now.

rm keep_only_Aq_branch_final_noAdmixed.tmp keep_only_Aq_branch_final_noAdmixed_sorted.tmp

vcftools --gzvcf DP8.AN10.noScaff0003.mac2.thin20kb.AqBranch.vcf.gz \
